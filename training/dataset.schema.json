{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FCP region feature dataset",
  "type": "object",
  "required": [
    "kind",
    "version",
    "images"
  ],
  "properties": {
    "kind": {
      "const": "fcp-feature-dataset"
    },
    "version": {
      "const": 1
    },
    "images": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "id",
          "split",
          "reviewed",
          "regions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "settings": {
            "type": "object",
            "properties": {
              "photoMode": {
                "type": "boolean"
              },
              "threshold": {
                "type": "number"
              }
            }
          },
          "split": {
            "enum": [
              "train",
              "validation"
            ]
          },
          "reviewed": {
            "const": true
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 240,
            "items": {
              "type": "object",
              "required": [
                "features",
                "label"
              ],
              "properties": {
                "label": {
                  "enum": [
                    "decoration",
                    "face",
                    "left_eye",
                    "right_eye",
                    "left_pupil",
                    "right_pupil",
                    "left_brow",
                    "right_brow",
                    "nose",
                    "mouth"
                  ]
                },
                "features": {
                  "type": "array",
                  "minItems": 9,
                  "maxItems": 9,
                  "items": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1.00001
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
