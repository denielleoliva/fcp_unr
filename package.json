{
  "name": "fcp_unr",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://denielleoliva.github.io/fcp_unr",
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@vizij/runtime-react": "^0.4.0",
    "lucide-react": "^0.263.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.180.0",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "predeploy": "npm run build && npm run docs:build && node scripts/copy-docs.cjs",
    "deploy": "gh-pages -d build --nojekyll",
    "test": "react-scripts test",
    "docs:build": ".venv-docs/bin/python -m sphinx -W --keep-going -b html docs docs/_build/html",
    "docs:serve": ".venv-docs/bin/python -m http.server 8000 --directory docs/_build/html"
  },
  "devDependencies": {
    "gh-pages": "^6.0.0",
    "react-scripts": "5.0.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
